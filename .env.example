PORT=3000
NODE_ENV=development

# Database Configuration (MySQL / MariaDB / XAMPP)
# Standard local development defaults (e.g., local XAMPP MySQL service)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=devprobe_db
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=10000

# Security / SSRF configuration
# Set to 'true' ONLY in controlled development test environments to allow localhost targets
DEVPROBE_ALLOW_LOCAL_TARGETS=false

# Day 12: Environment Secrets Encryption (AES-256-GCM)
# 32-byte hex-encoded string (64 characters) or 32-character string. Required for encrypting sensitive environment variables at rest.
# Generate a new random key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEVPROBE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

